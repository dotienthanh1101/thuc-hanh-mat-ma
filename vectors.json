      "r.01.MixColumns": "82825BBA636363636363636363636363",
      "r.01.AddRoundKey": "E0E138D9010000000100000001000000",
      "ciphertext": "0410BEFCCDE6944B69DD007DEBE39A9D"
    }
  },
